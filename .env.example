# Truth Social credentials — RECOMMENDED: token from your logged-in browser.
# How to get it: open truthsocial.com logged in → DevTools (F12) → Network tab →
# click any request to /api/v1/... → Headers → copy the value after
# "authorization: Bearer " (the token itself, without "Bearer ").
# Do NOT log out of the browser afterwards — that invalidates the token.
TRUTHSOCIAL_TOKEN=
# Fallback: username + password (OAuth password grant). Riskier: a bad session
# can trigger repeated logins, rate limits (429) and account verification.
# TRUTHSOCIAL_USERNAME=
# TRUTHSOCIAL_PASSWORD=

# Telegram Bot (required unless --dry-run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: auto-translate posts (e.g. pl, de, fr, es)
# TRANSLATE_TO=pl

# Optional: OpenAI API key for better translations (gpt-4o-mini)
# If not set, uses free Google Translate as fallback
# OPENAI_API_KEY=<openai_api_key>

# Optional: skip historical backlog after long downtime
# 21600 = 6 hours. Set to 0 to disable stale-state protection.
MAX_BACKFILL_AGE_SECONDS=21600

# Optional: maximum number of posts processed in one poll
# Protects against state corruption or unexpected API backlog.
MAX_POSTS_PER_POLL=20

# Optional: proxy for geo-restricted access
# http_proxy=socks5://127.0.0.1:1080
# https_proxy=socks5://127.0.0.1:1080
